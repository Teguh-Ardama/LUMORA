{
  "name": "lumora",
  "private": true,
  "version": "1.0.0",
  "description": "LUMORA — Enterprise Operator-Assisted Photobooth Platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lumora/db db:generate",
    "db:migrate": "pnpm --filter @lumora/db db:migrate",
    "db:push": "pnpm --filter @lumora/db db:push",
    "db:seed": "pnpm --filter @lumora/db db:seed",
    "dev:web": "pnpm --filter @lumora/web dev",
    "dev:worker": "pnpm --filter @lumora/worker dev",
    "dev:bridge": "pnpm --filter @lumora/bridge dev"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "sharp",
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
