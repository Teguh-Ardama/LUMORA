# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ char secrets. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
SIGNED_URL_SECRET=change-me-to-another-long-random-secret

# ── Database (Supabase PostgreSQL or local docker-compose) ──────────────
DATABASE_URL=postgresql://lumora:lumora@localhost:5434/lumora
DIRECT_URL=postgresql://lumora:lumora@localhost:5434/lumora

# ── Redis (queues, rate-limit, realtime pub/sub) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage: "supabase" or "local" ──────────────────────────────────────
STORAGE_DRIVER=local
# Local driver root (dev)
LOCAL_STORAGE_DIR=./storage
# Supabase driver
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lumora

# ── Delivery providers ──────────────────────────────────────────────────
# Email: "smtp" or "console" (dev: logs the email instead of sending)
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LUMORA <no-reply@lumora.app>"
# WhatsApp: "link" (click-to-chat, zero-config) or "twilio"
WHATSAPP_DRIVER=link
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Billing (prepaid credit wallet) ─────────────────────────────────────
# "dev" simulates payment locally (blocked in production); "xendit" is real.
PAYMENT_DRIVER=dev
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Integer IDR
PRICE_PER_SESSION_IDR=2000
LOW_BALANCE_THRESHOLD_IDR=20000

# ── Bridge ──────────────────────────────────────────────────────────────
# apps/bridge reads its own config at runtime; API base for the bridge:
BRIDGE_API_URL=http://localhost:3000
