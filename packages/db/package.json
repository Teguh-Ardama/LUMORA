{
  "name": "@lumora/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@lumora/contracts": "workspace:*",
    "@prisma/client": "6.2.1"
  },
  "devDependencies": {
    "@lumora/core": "workspace:*",
    "bcryptjs": "2.4.3",
    "@types/bcryptjs": "2.4.6",
    "dotenv-cli": "8.0.0",
    "prisma": "6.2.1",
    "sharp": "0.33.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "dotenv": "16.4.7"
  }
}
