// LUMORA — production schema.
// Conventions: UUID PKs, snake_case table names (PRD alignment), explicit
// indexes on every tenant-scoped access path, soft-delete only where the
// domain requires recoverability (events).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  OPERATOR
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SessionStatus {
  CAPTURING
  COMPOSING
  READY
  FAILED
  CLOSED
}

enum CaptureSource {
  WEBCAM
  BRIDGE
}

enum PhotoStatus {
  UPLOADED
  QUARANTINED
  DISCARDED
}

enum PhotoSource {
  WEBCAM
  BRIDGE
}

enum DeliveryChannel {
  QR
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  REVOKED
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
  CANCELLED
}

enum LayoutMode {
  GRID
  STRIP
}

enum FilterKind {
  NORMAL
  GRAYSCALE
  VINTAGE
  SEPIA
  COOL
  WARM
}

enum BridgeDeviceStatus {
  ONLINE
  OFFLINE
  REVOKED
}

enum ActorType {
  USER
  BRIDGE
  SYSTEM
}

enum CreditTransactionType {
  TOPUP
  SESSION_CHARGE
  REFUND
  ADJUSTMENT
}

enum TopupStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

// ── Identity & tenancy ───────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(120)
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  eventOperators EventOperator[]
  notifications  Notification[]
  invitesSent    Invite[]        @relation("InviteSender")
  printJobs      PrintJob[]
  sessions       Session[]

  @@map("users")
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(80)
  supportEmail String?  @map("support_email") @db.VarChar(255)
  brandColor   String?  @map("brand_color") @db.VarChar(9)
  /// Per-org override of the platform session price (integer IDR); NULL = platform default.
  sessionPriceIdr Int?  @map("session_price_idr")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  invites       Invite[]
  events        Event[]
  borders       Border[]
  layouts       Layout[]
  filters       Filter[]
  sessions      Session[]
  photos        Photo[]
  deliveries    Delivery[]
  printJobs     PrintJob[]
  bridgeDevices BridgeDevice[]
  auditLogs     AuditLog[]
  notifications Notification[]
  creditTransactions CreditTransaction[]
  topups        Topup[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           OrgRole
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           OrgRole
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@map("invites")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Events ───────────────────────────────────────────────────────────────

model Event {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String      @db.VarChar(160)
  clientName       String?     @map("client_name") @db.VarChar(160)
  venue            String?     @db.VarChar(200)
  status           EventStatus @default(DRAFT)
  startsAt         DateTime    @map("starts_at")
  endsAt           DateTime    @map("ends_at")
  defaultBorderId  String?     @map("default_border_id") @db.Uuid
  defaultLayoutId  String?     @map("default_layout_id") @db.Uuid
  framesPerSession Int         @default(4) @map("frames_per_session")
  countdownSeconds Int         @default(3) @map("countdown_seconds")
  createdById      String?     @map("created_by_id") @db.Uuid
  deletedAt        DateTime?   @map("deleted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultBorder Border?         @relation("EventDefaultBorder", fields: [defaultBorderId], references: [id], onDelete: SetNull)
  defaultLayout Layout?         @relation("EventDefaultLayout", fields: [defaultLayoutId], references: [id], onDelete: SetNull)
  operators     EventOperator[]
  borders       Border[]        @relation("EventBorders")
  layouts       Layout[]        @relation("EventLayouts")
  sessions      Session[]
  photos        Photo[]
  deliveries    Delivery[]
  printJobs     PrintJob[]
  bridgeDevices BridgeDevice[]

  @@index([organizationId, status])
  @@index([organizationId, startsAt])
  @@map("events")
}

model EventOperator {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_operators")
}

// ── Template library (FR-08: NULL org+event = GLOBAL) ───────────────────

model Border {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  eventId        String?   @map("event_id") @db.Uuid
  name           String    @db.VarChar(255)
  storageKey     String    @map("storage_key") @db.VarChar(500)
  width          Int
  height         Int
  sizeBytes      Int       @map("size_bytes")
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation("EventBorders", fields: [eventId], references: [id], onDelete: Cascade)
  sessions     Session[]
  defaultFor   Event[]       @relation("EventDefaultBorder")

  @@index([organizationId, eventId])
  @@map("borders")
}

model Layout {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String?    @map("organization_id") @db.Uuid
  eventId        String?    @map("event_id") @db.Uuid
  name           String     @db.VarChar(100)
  mode           LayoutMode
  photoCount     Int        @map("photo_count")
  config         Json       @map("template_config")
  isActive       Boolean    @default(true) @map("is_active")
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation("EventLayouts", fields: [eventId], references: [id], onDelete: Cascade)
  sessions     Session[]
  defaultFor   Event[]       @relation("EventDefaultLayout")

  @@index([organizationId, eventId])
  @@map("layouts")
}

model Filter {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String?    @map("organization_id") @db.Uuid
  name           String     @db.VarChar(100)
  kind           FilterKind
  params         Json
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([organizationId])
  @@map("filters")
}

// ── Sessions & photos ────────────────────────────────────────────────────

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  borderId       String?       @map("border_id") @db.Uuid
  layoutId       String        @map("layout_id") @db.Uuid
  filterId       String        @map("filter_id") @db.Uuid
  captureSource  CaptureSource @map("capture_source")
  status         SessionStatus @default(CAPTURING)
  guestName      String?       @map("guest_name") @db.VarChar(120)
  guestEmail     String?       @map("guest_email") @db.VarChar(255)
  guestWaNumber  String?       @map("guest_wa_number") @db.VarChar(50)
  startedById    String?       @map("started_by_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.VarChar(128)
  composedKey    String?       @map("composed_key") @db.VarChar(500)
  composedAt     DateTime?     @map("composed_at")
  composeMs      Int?          @map("compose_ms")
  composeError   String?       @map("compose_error") @db.VarChar(1000)
  startedAt      DateTime      @default(now()) @map("started_at")
  closedAt       DateTime?     @map("closed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  border       Border?         @relation(fields: [borderId], references: [id], onDelete: SetNull)
  layout       Layout          @relation(fields: [layoutId], references: [id])
  filter       Filter          @relation(fields: [filterId], references: [id])
  startedBy    User?           @relation(fields: [startedById], references: [id], onDelete: SetNull)
  photos       Photo[]
  tokens       DeliveryToken[]
  deliveries   Delivery[]
  printJobs    PrintJob[]
  creditTransactions CreditTransaction[]

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status])
  @@index([organizationId, createdAt])
  @@map("sessions")
}

model Photo {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  eventId          String      @map("event_id") @db.Uuid
  sessionId        String?     @map("session_id") @db.Uuid
  sequence         Int         @default(0)
  source           PhotoSource
  status           PhotoStatus @default(UPLOADED)
  storageKey       String      @map("storage_key") @db.VarChar(500)
  width            Int
  height           Int
  sizeBytes        Int         @map("size_bytes")
  originalFilename String?     @map("original_filename") @db.VarChar(255)
  idempotencyKey   String      @map("idempotency_key") @db.VarChar(128)
  capturedAt       DateTime?   @map("captured_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([eventId, idempotencyKey])
  @@index([sessionId, sequence])
  @@index([eventId, status])
  @@map("photos")
}

// ── Delivery ─────────────────────────────────────────────────────────────

model DeliveryToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("delivery_tokens")
}

model Delivery {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  channel        DeliveryChannel
  recipient      String          @db.VarChar(255)
  status         DeliveryStatus  @default(PENDING)
  error          String?         @db.VarChar(1000)
  sentAt         DateTime?       @map("sent_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([sessionId])
  @@map("deliveries")
}

model PrintJob {
  id            String         @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  sessionId     String         @map("session_id") @db.Uuid
  copies        Int            @default(1)
  status        PrintJobStatus @default(QUEUED)
  failureReason String?        @map("failure_reason") @db.VarChar(500)
  requestedById String?        @map("requested_by_id") @db.Uuid
  printedAt     DateTime?      @map("printed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([organizationId, createdAt])
  @@map("print_jobs")
}

// ── Desktop bridge ───────────────────────────────────────────────────────

model BridgeDevice {
  id            String             @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  eventId       String             @map("event_id") @db.Uuid
  name          String             @db.VarChar(120)
  platform      String             @db.VarChar(60)
  appVersion    String             @map("app_version") @db.VarChar(30)
  tokenHash     String             @unique @map("token_hash") @db.VarChar(128)
  status        BridgeDeviceStatus @default(ONLINE)
  queueDepth    Int                @default(0) @map("queue_depth")
  watchedFolder String?            @map("watched_folder") @db.VarChar(500)
  lastSeenAt    DateTime?          @map("last_seen_at")
  revokedAt     DateTime?          @map("revoked_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("bridge_devices")
}

// ── Billing (prepaid credit wallet) ──────────────────────────────────────

/// Append-only ledger. Balance = SUM(amount). Never mutate or delete rows.
model CreditTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  type           CreditTransactionType
  /// Integer IDR. Positive = credit in (topup/refund), negative = charge.
  amount         Int
  note           String?               @db.VarChar(300)
  sessionId      String?               @map("session_id") @db.Uuid
  topupId        String?               @map("topup_id") @db.Uuid
  createdById    String?               @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  topup        Topup?       @relation(fields: [topupId], references: [id], onDelete: SetNull)

  /// Idempotency: one charge per session, one credit per topup — forever.
  @@unique([sessionId, type])
  @@unique([topupId, type])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

model Topup {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  amount         Int
  status         TopupStatus @default(PENDING)
  provider       String      @db.VarChar(30)
  providerRef    String?     @map("provider_ref") @db.VarChar(120)
  paymentUrl     String?     @map("payment_url") @db.VarChar(600)
  paidAt         DateTime?   @map("paid_at")
  expiresAt      DateTime?   @map("expires_at")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([providerRef])
  @@map("topups")
}

// ── Audit & notifications ────────────────────────────────────────────────

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  actorName      String?   @map("actor_name") @db.VarChar(160)
  action         String    @db.VarChar(40)
  entityType     String    @map("entity_type") @db.VarChar(60)
  entityId       String?   @map("entity_id") @db.Uuid
  metadata       Json?
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String    @db.VarChar(40)
  title          String    @db.VarChar(200)
  body           String    @db.VarChar(1000)
  meta           Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}
